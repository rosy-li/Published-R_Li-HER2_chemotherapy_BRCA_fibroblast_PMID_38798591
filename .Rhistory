which(c(rownames(corr_data_t)==colnames(data2_quantiseq))==TRUE)
idx_HER2 <- which(colnames(data2_quantiseq)%in%patientID_HER2)
data2_quantiseq <- data2_quantiseq[,idx_HER2]
