#convert probe names to gene names
library(readr)
which(probe_list$ID != data_RNA_raw$V1)
#GENE_NAME = Gene Name
#UNIGENE_ID = UnigeneID
#ENSEMBL_ID = EnsemblID
#TIGR_ID = TIGRID
#ACCESSION_STRING = Accession String
#CHROMOSOMAL_LOCATION = Chromosomal Location
#CYTOBAND = Cytoband
#DESCRIPTION = Description
#GO_ID = GoIDs
#SEQUENCE = Sequence
library(dplyr)
which(probe_list$ID != data_RNA_raw$V1)
