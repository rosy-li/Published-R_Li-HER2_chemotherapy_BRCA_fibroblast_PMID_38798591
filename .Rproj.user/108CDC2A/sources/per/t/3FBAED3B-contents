#*delta PLK1 and SERPINE1 in RD vs. pCR
#*
gene <- "PLK1"
data_clinical_prepost$drug.response.ch2[1:89]==data_clinical_prepost$drug.response.ch2[90:178]
df_deltagene_stroma_response <- data.frame(
  gene_value = as.numeric(data_RNA_prepost[gene,c(90:178)]-data_RNA_prepost[gene,c(1:89)]),
  stroma_value_pre = as.numeric(res_estimate_prepost["stroma score",c(1:89)]),
  stroma_value_post = as.numeric(res_estimate_prepost["stroma score",c(90:178)]),
  response = data_clinical_prepost$drug.response.ch2[1:89]
)

ggplot(df_deltagene_stroma_response, aes(x=gene_value, y=stroma_value_post,color=response)) +
  geom_point()+ 
  geom_smooth(method = "lm", fill = NA)+
  stat_cor()+
  xlab(paste("Post minus pre therapy",gene))

df_deltagene_stroma_response %>%
  ggplot( aes(x=response, y=gene_value, fill=response)) +
  geom_boxplot() +
  geom_point(position=position_dodge(width=0.75),aes(group=response))+
  ylab(paste("Post minus pre therapy",gene))+
  stat_compare_means(method="wilcox.test")

