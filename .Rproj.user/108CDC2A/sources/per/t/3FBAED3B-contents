#identify patient treatment status
table(data_clinical_raw$characteristics_ch2)

data_clinical_raw$title

patientID_temp <- sub('.*vs. ', '', data_clinical_raw$title)
patientID_status <- sub(' BrTuB07.*','', patientID_temp)
patientID <- as.numeric(gsub("\\D", "", patientID_status))#substract all digits in a string

library(stringi)
patientID[stri_duplicated(patientID)]

data_RNA_prepost <- data_RNA_raw[,which(patientID %in% patientID[stri_duplicated(patientID)])]%>%as.data.frame
data_clinical_prepost <- data_clinical_raw[which(patientID %in% patientID[stri_duplicated(patientID)]),]
res_estimate_prepost <- res_estimate_raw[,which(patientID %in% patientID[stri_duplicated(patientID)])]



#correlations between pre- and post-therapy gene expression and stroma scores
gene <- "SERPINE1"
library(forcats)
library(ggplot2)
library(ggpubr)
df_gene_stroma <- data.frame(
  therapy = c(rep(c("pre","post"), each=178/2)),
  gene_value = as.numeric(data_RNA_prepost[gene,]),
  stroma_value = as.numeric(res_estimate_prepost["stroma score",])
)%>%mutate(therapy = fct_relevel(therapy, 
                                 "pre","post")) #mutate forces the levels of therapy to follow a "pre" "post" order
ggplot(df_gene_stroma, aes(x=gene_value, y=stroma_value,color=therapy)) +
  geom_point()+ 
  geom_smooth(method = "lm", fill = NA)+
  stat_cor()+
  xlab(paste("Expression levels of",gene))+
  ylab("ESTIMATE stroma score")

#paired box plot and correlations
ggpaired(df_gene_stroma, x = "therapy", y = "gene_value",line.color = "gray", line.size = 0.4,
         color="therapy",palette = "npg")+
  ylab(paste("Expression levels of",gene))+
  stat_compare_means(method = "t.test",paired=TRUE)

#stroma score changes before and after therapy
ggpaired(df_gene_stroma, x = "therapy", y = "stroma_value",line.color = "gray", line.size = 0.4,
         color="therapy",palette = "npg")+
  ylab("ESTIMATE stroma scores")+
  stat_compare_means(method = "t.test",paired=TRUE)

